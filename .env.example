# Put keys here locally. Never paste them into chat or commit this file as .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
TAVILY_API_KEY=
# auto: use LLM when configured; otherwise clearly labelled source excerpts.
ANSWER_MODE=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-base
MODEL_THREADS=4
RERANK_BATCH_SIZE=2

